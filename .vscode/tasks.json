{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Deploy extension",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}\\deploy.ps1"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Deploy extension (Release)",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}\\deploy.ps1", "-Configuration", "Release"],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Uninstall extension",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}\\deploy.ps1", "-Uninstall"],
      "problemMatcher": []
    }
  ]
}
